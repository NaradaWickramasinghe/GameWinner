<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="240dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/answer_overlay_bg"
    android:padding="16dp"
    android:elevation="12dp">

    <!-- Header row: title + close button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvDragHandle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🏆 GameWinner (Drag to move)"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnMinimizeAnswer"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:text="−"
            android:textColor="#99FFFFFF"
            android:textSize="16sp"
            android:background="#33FFFFFF" />

        <TextView
            android:id="@+id/btnCloseAnswer"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#99FFFFFF"
            android:textSize="16sp"
            android:background="#33FFFFFF" />
    </LinearLayout>

    <!-- Content Wrapper (Hidden when minimized) -->
    <LinearLayout
        android:id="@+id/llAnswerContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Confidence badge -->
        <TextView
            android:id="@+id/tvFloatingConfidence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#334CAF50"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="#FF4CAF50"
            android:textSize="11sp"
            android:textStyle="bold"
            android:text="95% confidence" />

        <!-- Answer text -->
        <TextView
            android:id="@+id/tvFloatingAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="B" />

        <!-- Reason text -->
        <TextView
            android:id="@+id/tvFloatingReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#BBFFFFFF"
            android:textSize="12sp"
            android:maxLines="3"
            android:ellipsize="end"
            android:text="Explanation here..." />

        <!-- OCR text (collapsed by default) -->
        <TextView
            android:id="@+id/tvFloatingOcr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#22FFFFFF"
            android:padding="6dp"
            android:textColor="#88FFFFFF"
            android:textSize="10sp"
            android:maxLines="4"
            android:ellipsize="end"
            android:visibility="gone" />

        <!-- Status text (shown during processing) -->
        <TextView
            android:id="@+id/tvFloatingStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FFFF9800"
            android:textSize="11sp"
            android:visibility="gone"
            android:text="Processing..." />

        <!-- Resize handle -->
        <TextView
            android:id="@+id/tvResizeHandle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="-8dp"
            android:layout_marginBottom="-8dp"
            android:gravity="center"
            android:text="↘"
            android:textColor="#99FFFFFF"
            android:textSize="20sp" />
    </LinearLayout>

</LinearLayout>
